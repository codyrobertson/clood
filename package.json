{
  "name": "clood-tui",
  "version": "1.0.0",
  "description": "Claude Code Dynamic Terminal UI - An interactive TUI for Claude Code CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clood-tui": "dist/index.js",
    "claude-tui": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:dist": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx src/index.tsx",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "claude",
    "cli",
    "tui",
    "terminal",
    "ui",
    "ink",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "chalk": "^5.3.0",
    "figures": "^6.1.0",
    "cli-highlight": "^2.1.11",
    "strip-ansi": "^7.1.0",
    "wrap-ansi": "^9.0.0",
    "yoga-layout": "^3.1.0",
    "zustand": "^4.5.2",
    "zod": "^3.23.8",
    "tail": "^2.2.6",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "@vitest/coverage-v8": "^1.5.0",
    "ink-testing-library": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
